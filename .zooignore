# --- Системные каталоги AI ---
.git/
.github/
.cline/
.roo/
.zoo/
.ai/

# --- Виртуальное окружение и кэши Python ---
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Nuitka: артефакты сборки ---
build/
dist/
*.build/
*.dist/
*.onefile-build/
*.exe
*.dmg
*.msi
*.apk
*.aab
*.ipa

# --- Настройки сред разработки (IDE) ---
.vscode/
.idea/
*.code-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Бинарные ассеты (не полезны для AI-контекста) ---
assets/
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.ttf
*.otf
*.mp3
*.wav
*.mp4
*.avi

# --- Секреты, локальные БД и логи ---
.env
.env.*
*.db
*.sqlite
*.sqlite3
*.log

# --- Отчёты и служебные артефакты проекта ---
reports/
inspect/
inspect_report.txt

# --- Служебные папки в destination (не внутри проекта, но на всякий случай) ---
!CCRun/
!Backup_*/

# --- Сами правила игнора ---
.zooignore
