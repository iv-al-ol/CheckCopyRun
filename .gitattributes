# Нормализация: в репозитории всегда LF.
* text=auto eol=lf

*.py       text eol=lf
*.toml     text eol=lf
*.md       text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.cfg      text eol=lf
*.ini      text eol=lf
*.txt      text eol=lf

# Windows-скрипты: CRLF (иначе cmd.exe может сломаться).
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Бинарные: без нормализации, без попыток diff.
*.ico      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.exe      binary
*.dll      binary
*.pyd      binary

# Lockfile: не засорять diff.
uv.lock    -diff linguist-generated
